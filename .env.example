# Both are optional. Leave them empty and the app runs in guest mode (browser storage only).
VITE_SUPABASE_URL=
# The public "anon" key. Never put the service_role key here: VITE_ values ship to the browser.
VITE_SUPABASE_ANON_KEY=
# Set to "true" only after enabling the Google provider in Supabase Auth.
VITE_ENABLE_GOOGLE_AUTH=false
